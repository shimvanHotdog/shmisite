{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shimvan-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "build": {
    "command": "node build.mjs"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  }
}
